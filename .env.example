ENVIRONMENT=<local-or-prod>

DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@localhost:5432/<db-name>
TEST_DATABASE_URL=postgresql+psycopg://<db-user>:<db-password>@localhost:5432/<test-db-name>

JWT_SECRET_KEY=<generate-a-long-random-secret>
JWT_ALGORITHM=<jwt-algorithm>
ACCESS_TOKEN_EXPIRE_MINUTES=<minutes>
REFRESH_TOKEN_EXPIRE_DAYS=<days>
RESET_TOKEN_EXPIRE_MINUTES=<minutes>
VERIFICATION_CODE_EXPIRE_MINUTES=<minutes>
VERIFICATION_RESEND_COOLDOWN_SECONDS=<seconds>
DOWNLOAD_TOKEN_EXPIRE_MINUTES=<minutes>

GOOGLE_SIGNIN_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_SIGNIN_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_SIGNIN_REDIRECT_URI=<your-backend-url>/api/v1/auth/google/callback

BACKEND_CORS_ORIGINS=["<your-frontend-url>"]
ALLOWED_HOSTS=["<your-allowed-hosts>"]

RATE_LIMIT_AUTH=<requests>/minute
RATE_LIMIT_DEFAULT=<requests>/minute
RATE_LIMIT_UPLOAD=<requests>/hour
RATE_LIMIT_AI=<requests>/minute

STORAGE_BACKEND=<local-or-supabase>
UPLOAD_DIR=<local-upload-dir, e.g. ./uploads>
SUPABASE_URL=<your-supabase-project-url>
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>
MAX_FILE_SIZE_MB=<megabytes>
ALLOWED_FILE_TYPES=["application/pdf","text/plain","text/markdown","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]

GEMINI_API_KEY=<your-gemini-api-key>
EMBEDDING_MODEL=<embedding-model-name, e.g. gemini-embedding-001>
CHAT_MODEL=<chat-model-name, e.g. gemini-3.8-flash>
